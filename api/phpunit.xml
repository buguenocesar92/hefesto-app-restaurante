<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <!--
        Las pruebas de aislamiento corren contra PostgreSQL de verdad, nunca
        contra SQLite: la Row Level Security que se quiere comprobar no existe
        en SQLite, asi que una prueba en SQLite probaria otra cosa.
        Ver docs/10-PRUEBAS-Y-ESTADO.md.
    -->
    <testsuites>
        <testsuite name="Unidad">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Caracteristicas">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:ZGVzZXBlbnRhZG9zZWFkZW1pbnN0cnVuY2lvbmVzdWE="/>
        <env name="APP_DEBUG" value="false"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="restaurante_pruebas"/>
        <env name="DB_USERNAME" value="restaurante_app"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6379"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>