# ---------------------------------------------------------------------------
# Plantilla de configuracion de la aplicacion de restaurante de Hefesto Studio.
# ---------------------------------------------------------------------------
# Este archivo NO tiene ningun valor real y no debe recibir ninguno.
# Copialo a .env y completa los valores en el servidor, nunca en el repositorio.
#
# Las variables marcadas con "GENERAR" se crean con el comando que se indica y
# no se eligen a mano.

# --- Aplicacion -----------------------------------------------------------
APP_NOMBRE="Aplicacion de restaurante"
APP_VERSION="0.1.0"
APP_ENV=produccion
APP_DEBUG=false
APP_KEY=
APP_URL=https://restaurante.ejemplo.cl
APP_WEB_URL=https://restaurante.ejemplo.cl

# --- Base de datos --------------------------------------------------------
# El rol de la base NO puede ser superusuario ni tener BYPASSRLS: con cualquiera
# de los dos, PostgreSQL ignora las politicas de Row Level Security y un
# restaurante podria ver los comandas de otro.
# `php artisan restaurante:verificar-aislamiento` lo comprueba.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=restaurante
DB_USERNAME=restaurante_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=restaurante_admin
DB_ADMIN_PASSWORD=

# --- Redis (reloj de cocina, cache y colas) --------------------------------
# El reloj de cocina vive aqui. La password es obligatoria en produccion.
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# --- Pantalla de cocina ---------------------------------------------------
# Cada cuanto, en milisegundos, la pantalla consulta los tiempos. No bajar de
# 3000: la pantalla esta junto a la cocina y recargar cada segundo no le aporta
# nada a quien cocina y carga el servidor.
COCINA_INTERVALO_REFRESCO_MS=3000
# Horas que se conserva la linea de tiempo de un pedido ya entregado. El
# historico real esta en la base y no se borra con esto.
COCINA_REDIS_RETENCION_HORAS=72

# --- Interfaz web (Nuxt) --------------------------------------------------
# GENERAR con: openssl rand -base64 32
# Sin esta clave la cookie de sesion no se puede sellar y el inicio de sesion
# no funciona. Es lo unico que impide que alguien fabrique su propia sesion.
NUXT_SESSION_PASSWORD=

# --- Authentik (identidad) -----------------------------------------------
# OIDC authorization code con PKCE. El `issuer` va SIN barra final: la
# aplicacion compara el valor con el que devuelve el documento de
# descubrimiento y una barra de mas hace que no coincidan.
#
# El dominio de Authentik debe ser el mismo que el de esta aplicacion para que
# la redireccion de retorno sea valida.
AUTHENTIK_ISSUER=https://identidad.ejemplo.cl/application-s/restaurante/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://restaurante.ejemplo.cl/api/auth/callback
# Grupo de Authentik que marca al administrador del local. La API es la
# autoridad del rol: este dato solo sirve para mostrar el nombre.
AUTHENTIK_GRUPO_ADMIN=restaurante-administradores

# --- Authentik (propio, solo para desarrollo) -----------------------------
# En produccion Authentik se instala aparte, con el kit "Hefesto Identidad".
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_BOOTSTRAP__EMAIL=
AUTHENTIK_BOOTSTRAP__PASSWORD=
AUTHENTIK_BOOTSTRAP__TOKEN=

# --- Comportamiento -------------------------------------------------------
# Rol que puede anular una comanda entera. La regla de que una comanda COBRADA
# no se anula desde este sistema no se cambia con esta variable: es una
# proteccion del cobro, no una preferencia de instalacion.
RESTAURANTE_ROL_QUE_ANULA=administrador
# Descuenta maxima del turno para no abrir comandas ni cobrar despues del
# cierre. Es una medida de desorden, no de seguridad.
RESTAURANTE_LIMITE_COMANDAS=60

# --- Integracion con el POS -----------------------------------------------
# NO IMPLEMENTADA. La columna queda documentada en docs/09-API.md. El punto de
# venta del cliente es la autoridad del cobro y esta aplicacion no lo contacta.
POS_HABILITADA=false
# Dejar vacio hasta que exista el contrato real del POS. Inventar un valor
# seria peor que no tener ninguno.
POS_URL=
POS_TOKEN=
POS_RUTA_COBROS_PENDIENTE=

# --- Despliegue -----------------------------------------------------------
# En produccion las migraciones se corren a mano, una vez. Con "true", todas
# las réplicas de la API las correrian al arrancar.
CORRER_MIGRACIONES=false